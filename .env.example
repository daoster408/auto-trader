# AUTO-TRADER Environment Configuration (copy to .env and never commit)
# All values required for startup validation

# Alpaca (paper first!)
ALPACA_API_KEY=your_paper_key_here
ALPACA_API_SECRET=your_paper_secret_here
ALPACA_PAPER=true

# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Comma-separated Telegram chat IDs or user IDs allowed to use any bot command.
# Fail-closed: empty means nobody is authorized.
TELEGRAM_ALLOWED_IDS=

# Resume / Kill authorization (simple shared secret for v1)
RESUME_TOKEN=change-me-to-strong-random-string-32chars
# Production/live safety default: process exit HALTs/flattens ACTIVE/PAUSED.
# Paper-only local supervised tests may set false so Ctrl+C/SIGTERM does not flatten.
SHUTDOWN_FLATTEN_ON_EXIT=true

# Risk profile (v1 defaults - changes must be logged in DECISIONS_LOG.md)
RISK_PER_TRADE_PCT=0.5
MAX_NEW_POSITIONS_PER_DAY=1
MAX_GROSS_EXPOSURE_PCT=25.0
DAILY_LOSS_HALT_PCT=-1.75
WEEKLY_LOSS_HALT_PCT=-4.0
PEAK_DRAWDOWN_HALT_PCT=-6.0
CONSECUTIVE_SL_HALT=2

# Supervisor / automation controls (default alert-only)
RECONCILE_INTERVAL_SECONDS=300
RECONCILE_LOOKBACK_DAYS=2
POSITION_MONITOR_INTERVAL_SECONDS=60
SUPERVISOR_TICK_TIMEOUT_SECONDS=20
AUTO_ENTRY_ENABLED=false
AUTO_EXIT_ENABLED=false
POSITION_MAX_LOSS_PCT=-5.0
POSITION_TAKE_PROFIT_PCT=8.0
POSITION_TRAILING_STOP_PCT=6.0
POSITION_MAX_HOLD_DAYS=10

# Timezone for reports (display only)
REPORT_TIMEZONE=America/Los_Angeles

# Persistence (HALTED state survives restarts here)
DB_PATH=auto_trader.db

# Optional: market-data enrichment (leave empty for Alpaca-only rules)
FINNHUB_API_KEY=

# AI research memo provider. Choices: shadow, openai, xai, anthropic, gemini.
# Shadow has no API cost and cannot place orders.
AI_RESEARCH_ENABLED=true
AI_RESEARCH_PROVIDER=shadow
# Optional multi-provider committee, e.g. anthropic,openai,xai. Leave blank for single-provider mode.
AI_RESEARCH_PROVIDERS=
AI_RESEARCH_MODEL=
# Optional provider-specific models. These override AI_RESEARCH_MODEL for that provider.
AI_RESEARCH_OPENAI_MODEL=
AI_RESEARCH_XAI_MODEL=
AI_RESEARCH_ANTHROPIC_MODEL=
AI_RESEARCH_GEMINI_MODEL=
# Real providers require an explicit model and positive daily budget before calls run.
AI_RESEARCH_TIMEOUT_SECONDS=8
AI_RESEARCH_MAX_CALLS_PER_DAY=0
# Cost-estimation assumptions only. Update these from provider pricing before activation.
AI_RESEARCH_EST_INPUT_TOKENS=15000
AI_RESEARCH_EST_OUTPUT_TOKENS=2000
AI_RESEARCH_INPUT_PRICE_PER_MTOK=5.0
AI_RESEARCH_OUTPUT_PRICE_PER_MTOK=25.0

# Optional: real AI provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Logging
LOG_LEVEL=INFO
